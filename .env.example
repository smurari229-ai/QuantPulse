# Optional server-side Gemini API key. Keep this secret out of Git and never prefix it with VITE_.
# The browser heuristic remains available; the AI view can call the server-side Gemini advisory route when this key is configured.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional public application URL used by server-side integrations when deployed.
APP_URL="MY_APP_URL"
